dplyr::filter(Year == year)
#Estimate incubation ----
##Compare estimate data with real data----
# Reshape the data into a long format to facilitate direct comparison of
# infection and onset dates
#model's first infections (infection pressure starting)
pressure_cols <- grep("^pressure", colnames(df_allsites_ok), value = TRUE)
#model's first symptoms (onset date)
onset_cols    <- grep("^ons", colnames(df_allsites_ok), value = TRUE)
#long table with infections
infections_estimate <- df_allsites_ok |>
dplyr::filter(bbchPhase > 10) |>
tidyr::pivot_longer(
cols = tidyselect::all_of(pressure_cols),
names_to = "model",
values_to = "infections"
) |>
# maintain site and first.symptom.date in the long format
dplyr::group_by(site, model,First.symptom.date,year) |>
dplyr::summarise(
Infect.estimate = min(Date[infections >= 1], na.rm = TRUE),
.groups = "drop"
) |>
# manage cases without infections (estimated by octopus)
dplyr::mutate(
Infect.estimate = ifelse(is.infinite(Infect.estimate), "No infection", as.character(Infect.estimate))
)|>
#remove 'pressure' prefix
dplyr::mutate(
model = sub("^pressure", "", model)
)
#long table with first symptoms (estimated by octopus)
first_symptoms_estimate <- df_allsites_ok |>
dplyr::filter(bbchPhase > 10) |>
tidyr::pivot_longer(
cols = tidyselect::all_of(onset_cols),
names_to = "model",
values_to = "symptoms"
)|>
# maintain site and first.symptom.date in the long format
dplyr::group_by(site, model,First.symptom.date,year) |>
dplyr::summarise(
onsetdate = min(Date[symptoms == 1], na.rm = TRUE),
.groups = "drop"
) |>
# manage cases without symptoms
dplyr::mutate(
onsetdate = ifelse(is.infinite(onsetdate), "No symptoms", as.character(onsetdate))
)|>
#remove 'ons' prefix
dplyr::mutate(
model = sub("^ons", "", model)
)
# Evaluate model accuracy by calculating the error between the observed
# and estimated symptom onset dates.
incubation_estimate_err <- first_symptoms_estimate |>
dplyr::mutate(
onsetdate = as.Date(onsetdate),
err_days = as.numeric(difftime(First.symptom.date, onsetdate, units = "days")),
err_hours = as.numeric(difftime(First.symptom.date, onsetdate, units = "hours")))
#Calculate the mean error for each model
mean_errors <- incubation_estimate_err|>
dplyr::group_by(model)|>
dplyr::summarise(err_ndays = round(mean(err_days, na.rm = TRUE),2),
err_nhours = round(mean(err_hours, na.rm = TRUE),2))
##Check incubation functionality in octopus----
# Calculates the incubation period by finding the difference
# between the infection date and the symptom onset date.
checK_inf_onset <- first_symptoms_estimate|>
dplyr::select(-First.symptom.date)|>
#incompatibility capital letter
dplyr::mutate(model = tolower(model))|>
dplyr::left_join(infections_estimate|>
dplyr::mutate(model = tolower(model)),
by = c("model", "site", "year"))|>
dplyr::select(-First.symptom.date)
#which one is wrong?
incorrect_estimates <- checK_inf_onset |>
dplyr::mutate(
onsetdate = as.Date(onsetdate),
Infect.estimate = dplyr::if_else(
Infect.estimate == "No infection",
NA_character_,
Infect.estimate
),
Infect.estimate = as.Date(Infect.estimate)
) |>
dplyr::filter(
is.na(Infect.estimate) |                        # case "No infection"
onsetdate < Infect.estimate |                   # onset befor infection
as.numeric(onsetdate - Infect.estimate) < 10) #incubation <10 days
# Remove rows where either the infection date or the symptom onset date is missing.
incorrect_estimates <- incorrect_estimates |>
dplyr::filter(!(is.na(onsetdate) & is.na(Infect.estimate)))
#Export table----
View(incorrect_estimates)
View(DiseaseDB)
#SCRIPT: Incubation_Calibration.R
#input 1: Field data(onset dates for location-year):
#- Source: Mira and Disease DB
#input 2: Octopus outputs (model predictions: primary infection and onset dates)
#DESCRIPTION
# This script analyzes the incubation period of a disease
# using both observed field data and predicted dates from multiple models.
# It compares model performance by evaluating how accurately each model's
# predicted onset dates align with the observed symptom from field data
#########################################################################
#SET UP
#Set up----
rm(list = ls())
#this path
setwd(dirname(rstudioapi::getActiveDocumentContext()$path))
#Input data formatting----
#NOTE: the dates provided represent the fist symptoms appearance not the primary infection
##Disease database data----
DiseaseDB <- read.csv("Primary_infection_Pvticola_realData.csv")
str(DiseaseDB)
#date format
DiseaseDB <-DiseaseDB|>
dplyr::mutate(First.symptom.date = as.Date(First.symptom.date))
DiseaseDB <- DiseaseDB|>
dplyr::rename(year = Year_Symptoms)|>
dplyr::select(LAU,First.symptom.date, year)|>
dplyr::rename(site = LAU)|>
dplyr::distinct(site, .keep_all = TRUE)
##Mira----
#import and format
MiraData <- read.csv("mira_firstSymptoms.csv")|>
dplyr::rename(First.symptom.date = MonitoringDate)|>
dplyr::mutate(First.symptom.date = as.Date(First.symptom.date))|>
dplyr::mutate(site = paste0(StationCode, "_", Localita))|>
dplyr::select(-StationCode, -Localita, - Regione,-Perc,-Longitudine, -Latitudine)|>
dplyr::select(site, First.symptom.date,year)
str(MiraData)
#Rbind between DiseaseDB and MiraData
DiseaseOnSet <- dplyr::bind_rows(DiseaseDB, MiraData)
##octoPus outputs----
#function: Imports and formats raw output files from Octopus
#(the file structure requires formatting)
import_octopus <- function(file) {
df <- read.csv(file, row.names = NULL)
# if columns are "shiftated"
colnames(df) <- colnames(df)[2:ncol(df)]
# remove last empty column
df <- df[1:(ncol(df)-1)]
return(df)
}
#import octopus output tables (together)
files <- list.files(path = "../bin/Debug/net7.0/outputs/diseaseModels/",
pattern = "\\.csv$", full.names = TRUE)
# remove estimatedHourly.csv
files <- files[!basename(files) %in% "estimatedHourly.csv"]
#obtain list with all outputs well formatted
list_df <- lapply(files, import_octopus)
#inspect files
lapply(list_df, names)
#join all data frames
df_allsites <- do.call(rbind, list_df)
#verify df structure
list_df[[1]]
# Prepare df for analysis
df_allsites_ok <- df_allsites |>
# remove file path from 'site'
dplyr::mutate(site = tools::file_path_sans_ext(basename(as.character(site)))) |>
# date formatting
dplyr::mutate(Date = as.POSIXct(Date, format = "%m/%d/%Y %H:%M"),
Date = as.Date(Date)) |>
dplyr::mutate(Year = lubridate::year(Date)) |>
dplyr::group_by(site) |>
#each site has more years of data: remove the first one (is not the target year)
#(except for site with only one year of data)
#dplyr::mutate(
#Min_Year = min(Year, na.rm = TRUE),
#n_years  = dplyr::n_distinct(Year)
#) |>
#dplyr::filter(
#(n_years == 1) | (Year > Min_Year)
#) |>
#remove temporary columns
#dplyr::select(-Min_Year,-n_years) |>
#dplyr::ungroup() |>
# filter target season
dplyr::filter(
plantSusceptibility > 0,
lubridate::month(Date) <= 8
) |>
dplyr::left_join(DiseaseOnSet, by = "site")|>
# Keep only the rows for the target year in both MIRA and DiseaseDB datasets.
dplyr::filter(Year == year)
#Estimate incubation ----
##Compare estimate data with real data----
# Reshape the data into a long format to facilitate direct comparison of
# infection and onset dates
#model's first infections (infection pressure starting)
pressure_cols <- grep("^pressure", colnames(df_allsites_ok), value = TRUE)
#model's first symptoms (onset date)
onset_cols    <- grep("^ons", colnames(df_allsites_ok), value = TRUE)
#long table with infections
infections_estimate <- df_allsites_ok |>
dplyr::filter(bbchPhase > 10) |>
tidyr::pivot_longer(
cols = tidyselect::all_of(pressure_cols),
names_to = "model",
values_to = "infections"
) |>
# maintain site and first.symptom.date in the long format
dplyr::group_by(site, model,First.symptom.date,year) |>
dplyr::summarise(
Infect.estimate = min(Date[infections >= 1], na.rm = TRUE),
.groups = "drop"
) |>
# manage cases without infections (estimated by octopus)
dplyr::mutate(
Infect.estimate = ifelse(is.infinite(Infect.estimate), "No infection", as.character(Infect.estimate))
)|>
#remove 'pressure' prefix
dplyr::mutate(
model = sub("^pressure", "", model)
)
#long table with first symptoms (estimated by octopus)
first_symptoms_estimate <- df_allsites_ok |>
dplyr::filter(bbchPhase > 10) |>
tidyr::pivot_longer(
cols = tidyselect::all_of(onset_cols),
names_to = "model",
values_to = "symptoms"
)|>
# maintain site and first.symptom.date in the long format
dplyr::group_by(site, model,First.symptom.date,year) |>
dplyr::summarise(
onsetdate = min(Date[symptoms == 1], na.rm = TRUE),
.groups = "drop"
) |>
# manage cases without symptoms
dplyr::mutate(
onsetdate = ifelse(is.infinite(onsetdate), "No symptoms", as.character(onsetdate))
)|>
#remove 'ons' prefix
dplyr::mutate(
model = sub("^ons", "", model)
)
# Evaluate model accuracy by calculating the error between the observed
# and estimated symptom onset dates.
incubation_estimate_err <- first_symptoms_estimate |>
dplyr::mutate(
onsetdate = as.Date(onsetdate),
err_days = as.numeric(difftime(First.symptom.date, onsetdate, units = "days")),
err_hours = as.numeric(difftime(First.symptom.date, onsetdate, units = "hours")))
#Calculate the mean error for each model
mean_errors <- incubation_estimate_err|>
dplyr::group_by(model)|>
dplyr::summarise(err_ndays = round(mean(err_days, na.rm = TRUE),2),
err_nhours = round(mean(err_hours, na.rm = TRUE),2))
##Check incubation functionality in octopus----
# Calculates the incubation period by finding the difference
# between the infection date and the symptom onset date.
checK_inf_onset <- first_symptoms_estimate|>
dplyr::select(-First.symptom.date)|>
#incompatibility capital letter
dplyr::mutate(model = tolower(model))|>
dplyr::left_join(infections_estimate|>
dplyr::mutate(model = tolower(model)),
by = c("model", "site", "year"))|>
dplyr::select(-First.symptom.date)
#which one is wrong?
incorrect_estimates <- checK_inf_onset |>
dplyr::mutate(
onsetdate = as.Date(onsetdate),
Infect.estimate = dplyr::if_else(
Infect.estimate == "No infection",
NA_character_,
Infect.estimate
),
Infect.estimate = as.Date(Infect.estimate)
) |>
dplyr::filter(
is.na(Infect.estimate) |                        # case "No infection"
onsetdate < Infect.estimate |                   # onset befor infection
as.numeric(onsetdate - Infect.estimate) < 10) #incubation <10 days
# Remove rows where either the infection date or the symptom onset date is missing.
incorrect_estimates <- incorrect_estimates |>
dplyr::filter(!(is.na(onsetdate) & is.na(Infect.estimate)))
#Export table----
View(incorrect_estimates)
