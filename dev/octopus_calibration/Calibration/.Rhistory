# plot aggiornato
p_map <- ggplot() +
geom_sf(data = Italy, fill = "gray95", color = "black") +
geom_point(data = df_map,
aes(x = lon, y = lat, color = clust),
size = 2.5, alpha = 0.9) +
# geom_text_repel(data = df_map,
#                 aes(x = lon, y = lat, label = PointID, color = clust),
#                 size = 2.5,
