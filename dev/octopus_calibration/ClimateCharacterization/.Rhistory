geom_sf(data = Italy, fill = "gray95", color = "black") +
geom_point(data = df_map,
aes(x = lon, y = lat, color = cluster),
size = 2.5, alpha = 0.9) +
geom_text_repel(data = df_map,
aes(x = lon, y = lat, label = PointID, color = cluster),
size = 2.5,
max.overlaps = 20,
fontface = "bold",
direction = "y",
hjust = 0,
nudge_x = 0.1,
box.padding = 0.2,
point.padding = 0.1,
min.segment.length = 0,
segment.size = 0.3,
segment.color = "gray50",
